# Copia este archivo a .env (en esta misma carpeta) y ajusta los valores.
# Antes de correr "python app.py" localmente, levanta la base de datos con:
#   docker compose up -d

PORT=4931

PGHOST=localhost
PGPORT=5434
PGUSER=santebio_admin
PGPASSWORD=cambia-esta-contraseña
PGDATABASE=santebio

JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio

# Llave de encripcion de datos sensibles en la base de datos (nombre,
# telefono, direcciones, tarjetas guardadas). Generarla con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Si esta llave se pierde o se cambia, los datos ya encriptados con la
# anterior dejan de poder leerse -- guardarla en un lugar seguro.
ENCRYPTION_KEY=genera-una-llave-con-el-comando-de-arriba

# Credenciales del primer usuario admin del panel (solo se usan si la
# tabla admins está vacía).
ADMIN_USUARIO=admin
ADMIN_PASSWORD=cambia-esta-contraseña

# Correo donde el admin recibe el aviso de cada pedido nuevo. Si se
# deja vacio, simplemente no se manda ese correo (el aviso en vivo
# dentro del panel de administrador sigue funcionando igual).
ADMIN_CORREO_NOTIFICACIONES=hola@capsulasdenopal.com

# Envio de correo para "cambiar/olvide mi contraseña" (email_utils.py).
# Si SMTP_HOST se deja vacio/comentado, no se envia ningun correo real:
# el enlace de confirmacion se imprime en la consola del servidor para
# poder probar el flujo completo sin credenciales todavia. En cuanto
# se tenga una cuenta de correo (Gmail con contraseña de aplicacion,
# SendGrid, Resend, etc.) solo hay que llenar estas variables.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tu-correo@gmail.com
# SMTP_PASSWORD=tu-contraseña-de-aplicacion
# SMTP_FROM=tu-correo@gmail.com

# URL publica del sitio, para armar el enlace que se manda por correo.
SITIO_URL=http://localhost:4930
